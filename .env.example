# FundingRadar: пример production-окружения для Docker Compose.
# Скопируйте в .env и замените все значения CHANGE_ME.
# .env не коммитится в репозиторий.

MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_DATABASE=funding

# MySQL-реквизиты для bot/Django. .env не коммитится в репозиторий.
MYSQL_USER=CHANGE_ME_DB_USER
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD

# Для контейнеров используются имена сервисов, а не localhost.
DB_HOST=mysql
DB_PORT=3306

# Telegram PROD TOKEN
TELEGRAM_BOT_TOKEN=CHANGE_ME_BOT_TOKEN
# Используется ботом при DEBUG=True; можно указать тот же токен.
TELEGRAM_BOT_TOKEN_DEV=CHANGE_ME_BOT_TOKEN
# Django использует этот токен только при DEBUG=True.
# В production (DEBUG=False) берётся TELEGRAM_BOT_TOKEN.
TELEGRAM_BOT_TOKEN_DJANGO=CHANGE_ME_BOT_TOKEN

# Telegram user ID администратора (длинное число)
ADMIN_ID=CHANGE_ME_ADMIN_ID

ORIGIN=https://fundingradar.ru
DEBUG=False

# Django
DJANGO_SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_ADDR=redis:6379

# MongoDB
MONGO_HOST=mongodb
MONGO_PORT=27017

# Go-сервис: Django и бот обращаются к нему по имени сервиса.
FILTER_HOST=service_go

# DSN для Go-сервиса; должен совпадать с MYSQL_USER/MYSQL_PASSWORD.
# Спецсимволы в пароле (@, :, / и т.п.) нужно URL-кодировать.
MYSQL_DSN=CHANGE_ME_DB_USER:CHANGE_ME_DB_PASSWORD@tcp(mysql:3306)/funding

# Необязательные прокси для коллекторов и бота.
# Если прокси не нужны, оставьте строки закомментированными.
# PROXY_HTTP=http://login:pass@ip:port
# proxy1=
# proxy_ourbit=
# DEX_PROXY_LIST=
