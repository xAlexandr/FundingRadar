FROM node:18 as build

WORKDIR /app

COPY frontend/package.json ./
COPY frontend/package-lock.json ./

RUN npm ci --legacy-peer-deps
COPY frontend/ ./
RUN npm run build

# Production image
FROM nginx:stable-alpine
COPY --from=build /app/build /usr/share/nginx/html

CMD ["nginx", "-g", "daemon off;"]